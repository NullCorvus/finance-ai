@startuml

skinparam componentStyle uml2
skinparam componentBackgroundColor White
skinparam componentBorderColor Black
skinparam componentFontColor Black
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam packageFontColor Black
skinparam defaultFontName Helvetica
skinparam defaultFontSize 18
skinparam ArrowColor Black
skinparam componentBackgroundColor White
skinparam componentBorderColor Black
skinparam componentFontColor Black
skinparam packageBackgroundColor White
skinparam packageBorderColor Black
skinparam packageFontColor Black
skinparam backgroundColor White
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 42

title Componentes de Finance AI
top to bottom direction

package "Frontend Flutter" {
  component "Navegación y presentación" as Navigation
  component "Interfaz de gestión financiera\ncuentas · categorías · gastos · ingresos\ntransferencias · presupuestos · historial" as FinanceUI
  component "Interfaz de captura\ntexto y recibos" as CaptureUI
  component "Gestión de sesión\ny credenciales" as ClientSession
  component "Cliente HTTP/REST\nJSON · multipart" as RestClient
}

package "Backend FastAPI" {
  component "API REST v1" as BackendAPI
  component "Autenticación y sesiones" as Auth
  component "Servicios financieros" as FinancialServices
  component "Captura de texto\npropuestas y confirmación" as TextCapture
  component "Captura de recibos\npropuestas y confirmación" as ReceiptCapture
  component "Gateway de texto\nselección y fallback" as TextGateway
  component "Gateway de visión\nselección y fallback" as VisionGateway
  component "Repositorios y UoW por módulo" as Repositories
}

package "Persistencia" {
  component "PostgreSQL\nalmacenamiento relacional" as PostgreSQL
}

package "IA" {
  component "Proveedor externo de IA" as AIProvider

}

' Dependencies (client -> supplier); structural, not execution order.
Navigation ..> FinanceUI
Navigation ..> CaptureUI
Navigation ..> ClientSession
FinanceUI ..> RestClient
CaptureUI ..> RestClient
ClientSession ..> RestClient
RestClient ..> BackendAPI : HTTPS / REST
BackendAPI ..> Auth
BackendAPI ..> FinancialServices
BackendAPI ..> TextCapture
BackendAPI ..> ReceiptCapture
Auth ..> Repositories
Auth -[hidden]right-> TextCapture
TextCapture -[hidden]right-> ReceiptCapture
FinancialServices ..> Repositories
TextCapture ..> Repositories
ReceiptCapture ..> Repositories
TextCapture ..> FinancialServices
ReceiptCapture ..> FinancialServices
TextCapture ..> TextGateway
ReceiptCapture ..> VisionGateway
TextGateway ..> AIProvider
VisionGateway ..> AIProvider
Repositories ..> PostgreSQL

' Layout-only rank constraints; hidden links do not describe system dependencies.
Navigation -[hidden]down-> CaptureUI
FinanceUI -[hidden]right-> CaptureUI
CaptureUI -[hidden]right-> ClientSession
CaptureUI -[hidden]down-> RestClient
RestClient -[hidden]down-> BackendAPI
PostgreSQL -[hidden]right-> AIProvider
@enduml
