// Project FinanceAI — Collaborative Database Vision (DBML)
// For dbdiagram.io: Paste directly into dbdiagram.io editor

Project FinanceAI {
  database_type: 'PostgreSQL'
  Note: '''
    Collaborative MVP database vision for Finance AI.
    Receipt is a simple purchase group with one or more Expense rows.
    Receipt and Expense can each have one optional image.
    This is a design draft for review in dbdiagram.io.
  '''
}

Enum account_type {
  cash
  bank
  digital_wallet
  savings
  credit_card
  other
}

Enum transaction_type {
  expense
  income
  transfer
  adjustment
}

Enum transaction_status {
  confirmed
  pending
  voided
}

Enum capture_source {
  manual
  text_ai
  audio_ai
  receipt_photo_ai
  import
}

Enum budget_schedule_type {
  recurring
  one_time
}

Enum frequency_unit {
  day
  week
  month
  year
}

Table currency {
  id bigint [pk, increment]
  code varchar(10) [not null, unique, note: 'Examples: COP, USD']
  name varchar(100) [not null]
  decimals smallint [not null, default: 2]
  is_active boolean [not null, default: true]
}

Table app_user {
  id bigint [pk, increment]
  email varchar(320) [not null, unique]
  password_hash varchar(255) [not null]
  preferred_currency_id bigint [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_session {
  id bigint [pk, increment]
  user_id bigint [not null]
  access_token_hash varchar(64) [not null, unique]
  platform varchar(16) [not null]
  access_expires_at timestamptz [not null]
  idle_expires_at timestamptz [not null]
  absolute_expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  last_renewed_at timestamptz [not null]
  revoked_at timestamptz
  revocation_reason varchar(32)

  indexes {
    (user_id, revoked_at, created_at)
  }
}

Table renewable_credential {
  id bigint [pk, increment]
  session_id bigint [not null]
  token_hash varchar(64) [not null, unique]
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz
  replaced_by_id bigint

  indexes {
    (session_id, issued_at)
  }
}

Table account {
  id bigint [pk, increment]
  user_id bigint [not null]
  currency_id bigint [not null]
  name varchar(100) [not null, note: 'Examples: Cash, Nequi, Bancolombia, savings, credit card']
  type account_type [not null]
  opening_balance decimal(18,2) [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, name) [unique]
    (user_id, is_active)
  }
}

Table category {
  id bigint [pk, increment]
  user_id bigint [not null]
  name varchar(100) [not null]
  color varchar(20)
  icon varchar(50)
  is_active boolean [not null, default: true]

  indexes {
    (user_id, name) [unique]
  }
}

Table store {
  id bigint [pk, increment]
  user_id bigint [not null]
  name varchar(150) [not null]
  normalized_name varchar(150) [not null, note: 'Supports joining spelling variations for store analytics']
  is_active boolean [not null, default: true]

  indexes {
    (user_id, normalized_name) [unique]
  }
}

Table income_source {
  id bigint [pk, increment]
  user_id bigint [not null]
  name varchar(100) [not null]
  is_active boolean [not null, default: true]

  indexes {
    (user_id, name) [unique]
  }
}

Table financial_transaction {
  id bigint [pk, increment]
  user_id bigint [not null]
  income_source_id bigint [note: 'Used only when type is income']
  type transaction_type [not null]
  status transaction_status [not null, default: 'confirmed']
  occurred_at timestamptz [not null]
  description varchar(250)
  source capture_source [not null, default: 'manual']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, occurred_at)
    (user_id, type, occurred_at)
    (income_source_id, occurred_at)
  }

  checks {
    `type = 'income' OR income_source_id IS NULL` [name: 'income_source_only_for_income']
  }

  Note: 'Common history event. income_source_id must be null unless type is income. AI input is not confirmed until the user accepts it.'
}

Table account_movement {
  id bigint [pk, increment]
  transaction_id bigint [not null]
  account_id bigint [not null]
  amount decimal(18,2) [not null, note: 'Signed in account currency: negative leaves, positive enters']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, transaction_id)
    (transaction_id)
  }

  checks {
    `amount <> 0` [name: 'movement_amount_not_zero']
  }

  Note: 'Expense normally has one negative movement, income one positive, and transfer a negative plus a positive movement. Several movements can support split accounts without modeling access methods.'
}

Table receipt {
  id bigint [pk, increment]
  transaction_id bigint [not null, unique]
  store_id bigint
  category_id bigint
  currency_id bigint [not null]
  name varchar(200) [not null, note: 'Simple purchase-group name displayed in the UI']
  purchased_at timestamptz [not null]
  total_amount decimal(18,2) [not null]
  note text
  image_path text [note: 'Optional backend-managed image path; the image itself is not stored in PostgreSQL']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (store_id, purchased_at)
    (category_id, purchased_at)
  }

  checks {
    `total_amount > 0` [name: 'receipt_total_positive']
  }

  Note: 'Required purchase group for an expense transaction. It contains one or more Expense rows. Store and category are optional. The app can calculate total_amount from expenses or let the user adjust it without storing a separate total-source mode.'
}

Table expense {
  id bigint [pk, increment]
  receipt_id bigint [not null]
  category_id bigint
  position smallint [not null, default: 1]
  name varchar(200) [not null, note: 'Original manual or receipt-extracted name']
  quantity decimal(12,3) [not null, default: 1]
  unit_price decimal(18,2)
  amount decimal(18,2) [not null, note: 'Total price for this individual expense']
  note text
  image_path text [note: 'Optional image of this individual expense or item']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (receipt_id, position) [unique]
    (category_id)
  }

  checks {
    `quantity > 0` [name: 'expense_quantity_positive']
    `unit_price IS NULL OR unit_price >= 0` [name: 'expense_unit_price_non_negative']
    `amount >= 0` [name: 'expense_amount_non_negative']
  }

  Note: 'A lone purchase has one Expense row; a mixed receipt has several rows. Null category is displayed as Uncategorized.'
}

Table budget {
  id bigint [pk, increment]
  user_id bigint [not null]
  currency_id bigint [not null]
  category_id bigint [note: 'Null means an overall spending budget']
  name varchar(120) [not null]
  amount decimal(18,2) [not null]
  schedule_type budget_schedule_type [not null]
  frequency_unit frequency_unit [note: 'Required only for recurring budgets']
  frequency_interval smallint [note: 'Required and greater than zero for recurring budgets']
  starts_on date [not null]
  ends_on date
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, is_active)
    (user_id, starts_on, ends_on)
    (category_id, is_active)
  }

  checks {
    `amount > 0` [name: 'budget_amount_positive']
    `ends_on IS NULL OR ends_on >= starts_on` [name: 'budget_date_order']
    `frequency_interval IS NULL OR frequency_interval > 0` [name: 'budget_interval_positive']
    `(schedule_type = 'recurring' AND frequency_unit IS NOT NULL AND frequency_interval IS NOT NULL) OR (schedule_type = 'one_time' AND frequency_unit IS NULL AND frequency_interval IS NULL)` [name: 'budget_schedule_fields']
  }

  Note: 'Recurring examples: every 1 month or every 2 weeks. One-time budgets leave frequency fields null and use starts_on plus optional ends_on for a custom range. Database constraints enforce the valid field combinations and ends_on >= starts_on.'
}

Ref: app_user.preferred_currency_id > currency.id [delete: restrict]
Ref: user_session.user_id > app_user.id [delete: cascade]
Ref: renewable_credential.session_id > user_session.id [delete: cascade]
Ref: renewable_credential.replaced_by_id > renewable_credential.id [delete: set null]

Ref: account.user_id > app_user.id [delete: cascade]
Ref: account.currency_id > currency.id [delete: restrict]

Ref: category.user_id > app_user.id [delete: cascade]
Ref: store.user_id > app_user.id [delete: cascade]
Ref: income_source.user_id > app_user.id [delete: cascade]

Ref: financial_transaction.user_id > app_user.id [delete: cascade]
Ref: financial_transaction.income_source_id > income_source.id [delete: set null]
Ref: account_movement.transaction_id > financial_transaction.id [delete: cascade]
Ref: account_movement.account_id > account.id [delete: restrict]

Ref: receipt.transaction_id - financial_transaction.id [delete: cascade]
Ref: receipt.store_id > store.id [delete: set null]
Ref: receipt.category_id > category.id [delete: set null]
Ref: receipt.currency_id > currency.id [delete: restrict]

Ref: expense.receipt_id > receipt.id [delete: cascade]
Ref: expense.category_id > category.id [delete: set null]

Ref: budget.user_id > app_user.id [delete: cascade]
Ref: budget.currency_id > currency.id [delete: restrict]
Ref: budget.category_id > category.id [delete: set null]

TableGroup IdentityAndReference {
  currency
  app_user
  user_session
  renewable_credential
}

TableGroup AccountsAndMovements {
  account
  financial_transaction
  account_movement
  income_source
}

TableGroup ReceiptsAndExpenses {
  receipt
  expense
  store
}

TableGroup ClassificationAndPlanning {
  category
  budget
}
